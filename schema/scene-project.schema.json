{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-sync.local/schema/scene-project.schema.json",
  "title": "Video Sync Scene Studio project",
  "description": "Editable authoring document compiled into the schema v4 live runtime scene.",
  "type": "object",
  "additionalProperties": false,
  "required": ["projectVersion", "schemaVersion", "id", "name", "previewBpm", "createdAt", "updatedAt", "sources", "clips", "visualLoops", "defaultLoopId"],
  "properties": {
    "projectVersion": { "const": 1 },
    "schemaVersion": { "const": 5 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "style": { "type": "string" },
    "source": { "type": "string" },
    "sourcePage": { "type": "string" },
    "group": { "type": "string" },
    "previewBpm": { "type": "number", "minimum": 20, "maximum": 300 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "clips": { "type": "array", "items": { "$ref": "#/$defs/clip" } },
    "visualLoops": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/visualLoop" } },
    "defaultLoopId": { "$ref": "#/$defs/id" },
    "cueBindings": { "type": "array", "maxItems": 8, "deprecated": true, "description": "Legacy mappings; cue assignments are derived from visualLoops order.", "items": { "$ref": "#/$defs/cueBinding" } },
    "randomLoop": { "type": "object" },
    "advance": { "type": "object", "properties": { "afterSongs": { "type": "integer", "minimum": 1 } } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "point": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": { "x": { "type": "number", "minimum": 0, "maximum": 1 }, "y": { "type": "number", "minimum": 0, "maximum": 1 } } },
    "musicalTime": { "type": "object", "additionalProperties": false, "minProperties": 1, "properties": { "bars": { "type": "number", "minimum": 0 }, "beats": { "type": "number", "minimum": 0 } } },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "file", "fileName", "durationSeconds"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "label": { "type": "string" }, "file": { "type": "string" }, "fileName": { "type": "string" }, "durationSeconds": { "type": "number", "exclusiveMinimum": 0 }, "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 }, "fps": { "type": "number", "exclusiveMinimum": 0 }, "originUrl": { "type": "string" } }
    },
    "clip": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sourceId", "label", "inSeconds", "outSeconds", "color", "defaultEndBehavior"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "sourceId": { "$ref": "#/$defs/id" }, "label": { "type": "string" }, "inSeconds": { "type": "number", "minimum": 0 }, "outSeconds": { "type": "number", "exclusiveMinimum": 0 }, "color": { "type": "string" }, "subjectFocus": { "$ref": "#/$defs/point" }, "defaultEndBehavior": { "enum": ["loop", "hold"] } }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "clipId", "at", "duration", "source", "appearance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "clipId": { "$ref": "#/$defs/id" }, "lane": { "type": "integer", "minimum": 0 }, "at": { "$ref": "#/$defs/musicalTime" }, "duration": { "$ref": "#/$defs/musicalTime" },
        "source": { "type": "object", "additionalProperties": false, "required": ["offsetSeconds", "rate", "endBehavior"], "properties": { "offsetSeconds": { "type": "number", "minimum": 0 }, "rate": { "type": "number", "exclusiveMinimum": 0 }, "endBehavior": { "enum": ["loop", "hold"] } } },
        "appearance": { "type": "object", "required": ["z", "opacity", "blendMode", "fit", "filters"], "properties": { "z": { "type": "integer" }, "opacity": { "type": "number", "minimum": 0, "maximum": 1 }, "blendMode": { "enum": ["normal", "screen", "multiply", "plus-lighter"] }, "fit": { "enum": ["cover", "contain"] }, "filters": { "type": "array" }, "motion": { "type": "object" } } }
      }
    },
    "visualLoop": { "type": "object", "additionalProperties": false, "required": ["id", "name", "length", "repeat", "events"], "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "type": "string" }, "length": { "$ref": "#/$defs/musicalTime" }, "repeat": { "const": true }, "compositing": { "const": "layers", "deprecated": true, "description": "Legacy property retained for saved-project compatibility; lane stacking is always active." }, "events": { "type": "array", "items": { "$ref": "#/$defs/event" } } } },
    "cueBinding": { "type": "object", "additionalProperties": false, "required": ["input", "loopId", "cueType"], "properties": { "input": { "type": "string", "pattern": "^hotCue[A-H]$" }, "loopId": { "type": ["string", "null"] }, "cueType": { "enum": ["loop", "jump"] } } }
  }
}
