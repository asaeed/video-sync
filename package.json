{
  "name": "video-sync",
  "description": "Low-latency, beat-synchronous video visuals for Rekordbox with a browser renderer, scene sequencer, and Link/MIDI bridge.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asaeed/video-sync.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bridge:build": "cmake -S bridge -B .build/bridge -DCMAKE_BUILD_TYPE=Release && cmake --build .build/bridge --parallel",
    "media:archive": "node scripts/fetch-archive-scene.mjs",
    "media:validate": "node scripts/validate-scene-catalog.mjs",
    "scenes:export": "node scripts/export-scene-contracts.mjs",
    "dev": "node poc/server.mjs",
    "test": "node --test poc/tests/*.test.mjs"
  }
}
